#! /usr/bin/env node
'use strict';

var os = require('os');
var path = require('path');

var {loadConfig} = require('../lib/config_loader');
var EventConsumer = require('../lib/event_consumer');
var Server = require('../lib/Server');
var logger = require('../lib/logger').get();

var config = loadConfig([
  path.join(__dirname, '..', 'default.yaml'),
  '/' + path.join('etc', 'probo', 'notifier.yaml'),
  '/' + path.join('etc', 'probo', 'notifier.d'),
  path.join(os.homedir(), '.probo-notifier.yaml'),
]);

var streamConfig = config.eventStreams.buildEvents.config;
streamConfig.plugin = config.eventStreams.buildEvents.plugin;

var server = new Server({
  consumer: new EventConsumer(streamConfig),
});

server.start(function() {
  logger.info('Probo Notifier server started');
});
